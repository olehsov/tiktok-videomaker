{
  "languages": {
    "primary": "en",
    "supported": [
      "en",
      "uk",
      "ru"
    ]
  },
  "tts": {
    "provider": "elevenlabs",
    "model": "eleven_multilingual_v2",
    "outputFormat": "mp3_44100_128",
    "voices": {
      "en": "REPLACE_WITH_YOUR_ELEVENLABS_VOICE_ID",
      "uk": "REPLACE_WITH_YOUR_ELEVENLABS_VOICE_ID",
      "ru": "REPLACE_WITH_YOUR_ELEVENLABS_VOICE_ID"
    },
    "voiceSettings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0,
      "use_speaker_boost": true,
      "speed": 1
    },
    "maxRetries": 2
  },
  "timing": {
    "minDurationSec": 60,
    "maxDurationSec": 120,
    "tailSec": 1.5,
    "silenceDetect": {
      "noiseDb": -35,
      "minSilenceSec": 0.25
    }
  },
  "music": {
    "source": "elevenlabs",
    "model": "music_v2",
    "lengthSec": 30,
    "loopCrossfadeSec": 2,
    "volume": 0.12,
    "fadeInSec": 1,
    "fadeOutSec": 2,
    "ducking": {
      "enabled": true,
      "duckDb": -8,
      "attackMs": 150,
      "releaseMs": 600
    },
    "promptTemplate": "Calm, curious documentary background music. Soft felt piano and kalimba over warm ambient pads, gentle light pulse around 80 BPM, major / lydian feeling of discovery and wonder. Instrumental only: no vocals, no strong lead melody, no drum hits, no sudden changes, steady energy from start to end. Seamless loop: the ending flows naturally back into the beginning — same key, tempo and texture at the start and at the end, no intro, no outro, no final cadence. Cultural colour (subtle, in texture only): {{topic}}"
  },
  "pipeline": {
    "defaultLanguages": [
      "en"
    ],
    "autoSelectTopic": false,
    "autoStartProduction": false,
    "autoApprovePlan": false,
    "maxReviewLoops": 2,
    "autoTrimOverlong": true,
    "autoApprovePreview": false,
    "autoPrepareUpload": false,
    "asyncMarketing": true,
    "autoPromoteKit": false,
    "publish": "off"
  },
  "marketing": {
    "privacyLevel": "SELF_ONLY",
    "disableDuet": false,
    "disableStitch": false,
    "disableComment": false,
    "isAigc": true,
    "alsoShortsAndReels": true
  },
  "look": {
    "saturation": 1.1,
    "lightness": 1.1,
    "maxLightness": 0.94,
    "contrast": 1,
    "temperature": 0,
    "faceShading": 0.5,
    "outline": 0,
    "shadowOpacity": 0.25,
    "depthFade": 0.3,
    "nightDarkness": 0.35,
    "nightBlue": 0.5,
    "uiScale": 1,
    "captionScale": 1,
    "captionShadow": 0.6,
    "sharpen": 0.3,
    "crf": 18,
    "x264Tune": "animation",
    "grain": 0,
    "vignette": 0
  }
}
