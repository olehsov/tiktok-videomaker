{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx hyperframes *)",
      "Bash(node tools/*)",
      "Bash(node --env-file=.env tools/*)",
      "Bash(node build.mjs *)",
      "Bash(node videos/*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(cp -r videos/_template *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Edit(./videos/**)",
      "Write(./videos/**)",
      "Edit(./topics.md)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)"
    ]
  }
}
