#!/usr/bin/env bash
# Blocks a commit when staged changes contain an ElevenLabs-style key (sk_...) or a .env file.
set -u
fail=0
env_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..*)?$' | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$env_files" ]; then
  echo "pre-commit: refusing to commit .env file(s):" >&2
  echo "$env_files" | sed 's/^/  /' >&2
  fail=1
fi
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' | grep -qE 'sk_[A-Za-z0-9]{20,}'; then
  echo "pre-commit: staged changes contain a key matching sk_[A-Za-z0-9]{20,}. Remove it and unstage." >&2
  fail=1
fi
exit $fail
